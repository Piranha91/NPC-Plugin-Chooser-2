<!-- ShowInTaskbar is True for the same reason as InvalidSelectionsWindow: a modal report the user
     may read for a while should not leave the main window looking frozen after an app switch. -->
<Window x:Class="NPC_Plugin_Chooser_2.Views.EasyNpcTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
        xmlns:themes="clr-namespace:NPC_Plugin_Chooser_2.Themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:VM_EasyNpcTransferWindow}"
        Title="EasyNPC Transfer"
        Height="640" Width="1240"
        MinHeight="360" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Style="{DynamicResource ThemedWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="WrapCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <themes:TitleBarThemingBehavior />
    </i:Interaction.Behaviors>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SummaryText}"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8" CornerRadius="3"
                Background="#22808080" BorderBrush="#55808080" BorderThickness="1"
                Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" FontStyle="Italic"/>
        </Border>

        <!-- Filter + toggles; each toggle only shows when it has rows to act on. -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     ToolTip="Filter rows by any column"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Show unchanged"
                          IsChecked="{Binding ShowUnchanged, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Visibility="{Binding HasUnchangedRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="Show NPCs whose selection would stay exactly as it is."/>
                <CheckBox Content="Use first match for ambiguous NPCs"
                          IsChecked="{Binding UseFirstMatch, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Visibility="{Binding HasAmbiguousRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="Several mod entries provide the same plugin for these NPCs. Ticked: use the first one (listed in the New column; the others are in Note). Unticked: skip them."/>
            </StackPanel>
        </Grid>

        <!-- Styled inline like InvalidSelectionsWindow; the theme files carry NO implicit
             DataGrid styles. The Current/New headers are set per operation by the window. -->
        <DataGrid Grid.Row="3"
                  x:Name="ResultsGrid"
                  ItemsSource="{Binding FilteredRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  ClipboardCopyMode="ExcludeHeader"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Background="{DynamicResource SecondaryBackground}"
                  Foreground="{DynamicResource PrimaryForeground}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  RowBackground="{DynamicResource SecondaryBackground}"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy selected cells"
                              Command="ApplicationCommands.Copy"
                              InputGestureText="Ctrl+C"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="NPC" Binding="{Binding Npc}" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="FormKey" Binding="{Binding FormKey}" Width="150"/>
                <DataGridTextColumn x:Name="CurrentColumn" Header="Current" Binding="{Binding Current}" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn x:Name="NewColumn" Header="New" Binding="{Binding New}" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="Face Plugin" Binding="{Binding FacePlugin}" Width="140" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="FaceGen Source" Binding="{Binding FaceGenSource}" Width="130" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="Default Plugin" Binding="{Binding DefaultPlugin}" Width="140" ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" MinWidth="180" ElementStyle="{StaticResource WrapCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Copy Sheet" Command="{Binding CopySheetCommand}"
                        Height="30" Padding="12,0"
                        ToolTip="Copy every row (including unchanged ones) as tab-separated text; paste directly into Excel."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ConfirmText}" Click="ConfirmButton_Click"
                        IsEnabled="{Binding CanConfirm}"
                        Height="30" Padding="12,0" IsDefault="True"/>
                <Button Content="Cancel" Click="CancelButton_Click"
                        Height="30" Width="100" Margin="10,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
