<reactiveui:ReactiveUserControl x:Class="NPC_Plugin_Chooser_2.Views.ModIssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NPC_Plugin_Chooser_2.Views"
             xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
             xmlns:reactiveui="http://reactiveui.net"
             mc:Ignorable="d"
             x:TypeArguments="vm:VM_ModIssues"
             d:DataContext="{d:DesignInstance Type=vm:VM_ModIssues}"
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="ModIssuesView_Loaded">

    <UserControl.Resources>
        <local:BooleanNegationConverter x:Key="BooleanNegationConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:PercentageSizingConverter x:Key="PercentageSizingConverter"/>
        <local:ModKeyToStringConverter x:Key="ModKeyToStringConverter"/>
        <local:AreModKeysEqualMultiConverter x:Key="AreModKeysEqualMultiConverter"/>
        <local:AreEqualMultiConverter x:Key="AreEqualConverter"/>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Scan toolbar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Zoom bar -->
        </Grid.RowDefinitions>

        <!-- ====================== Scan toolbar ====================== -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Scan:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <!-- Searchable scan-target picker: type to filter (substring),
                         pick ALL or a mod. Auto-open-while-typing lives in
                         code-behind (ScanTargetComboBox_TextChanged). -->
                    <ComboBox x:Name="ScanTargetComboBox"
                              MinWidth="150" MaxWidth="280" Margin="0,0,8,0" VerticalAlignment="Center"
                              IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                              ItemsSource="{Binding ScanTargetOptions}"
                              Text="{Binding ScanTargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              TextBoxBase.TextChanged="ScanTargetComboBox_TextChanged"
                              DropDownOpened="ScanTargetComboBox_DropDownOpened"
                              ToolTip="Which mod to scan. ALL scans every eligible appearance mod.&#x0a;Type to search the list — Scan then covers the exact pick, or every mod matching the typed text."/>
                    <Button Content="Scan" Command="{Binding ScanCommand}" Padding="10,3" Margin="0,0,5,0"
                            ToolTip="Scan the targeted appearance mods for missing assets (ALL = every installed appearance mod). Mods that haven't changed since the last scan are skipped (cached)."/>
                    <Button Content="Rescan All" Command="{Binding RescanAllCommand}" Padding="10,3" Margin="0,0,5,0"
                            ToolTip="Scan the targeted mods from scratch, ignoring cached results."/>
                    <Button Content="Cancel" Command="{Binding CancelScanCommand}" Padding="10,3" Margin="0,0,10,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Padding="10,3" Margin="0,0,10,0"
                            ToolTip="Export all detected issues to a CSV file."/>
                </StackPanel>

                <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures
                     children with infinite width, so the status text would need a
                     hard MaxWidth to ellipsize — which then truncated messages the
                     toolbar had room for. Docked, the text fills the actual
                     remaining width and only trims when the window is narrow
                     (tooltip carries the full message for that case). -->
                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <ProgressBar DockPanel.Dock="Left" Width="180" Height="16" VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="{Binding ScanProgressMaximum}"
                                 Value="{Binding ScanProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScanEtaText}" VerticalAlignment="Center"
                               Margin="8,0,0,0" FontStyle="Italic"/>
                    <TextBlock Text="{Binding ScanStatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ScanStatusMessage}"/>
                </DockPanel>

                <TextBlock Grid.Column="2" Text="{Binding LastScanText}" VerticalAlignment="Center"
                           Foreground="Gray" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- ====================== Main content ====================== -->
        <Grid Grid.Row="1" x:Name="MainContentGridForSplitter">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="LeftColumnForModList"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300" x:Name="RightPanelColumn"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: filters + mods-with-issues list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="5">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,2,15,2">
                            <TextBlock Text="Filter Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding NameFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="120" VerticalAlignment="Center"
                                     ToolTip="Filter the list by mod display name&#x0a;Ctrl+Shift+C clears all search filters"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,15,2">
                            <TextBlock Text="Filter NPC:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding NpcSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="120" VerticalAlignment="Center"
                                     ToolTip="Show only mods with an affected NPC whose name or FormKey matches&#x0a;Ctrl+Shift+C clears all search filters"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,15,2">
                            <TextBlock Text="Issue Type:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding AvailableIssueTypeFilters}"
                                      SelectedItem="{Binding SelectedIssueTypeFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      MinWidth="140" VerticalAlignment="Center"
                                      ToolTip="Show only mods (and NPC tiles) with this kind of issue"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IncludeOutfitOnlyIssues, Mode=TwoWay}"
                                  Content="Include outfit-only issues"
                                  VerticalAlignment="Center" Margin="0,2,15,2"
                                  ToolTip="If unchecked, mods and NPCs whose only problems are outfit/headgear-related are hidden, leaving just face and body defects."/>
                        <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <CheckBox IsChecked="{Binding ShowIssues, Mode=TwoWay}"
                                  Content="{Binding ShowIssuesLabel}"
                                  VerticalAlignment="Center" Margin="0,2,10,2"
                                  ToolTip="Issues are visibly broken in game right now — dark faces, invisible or untextured meshes, missing required mods."/>
                        <CheckBox IsChecked="{Binding ShowWarnings, Mode=TwoWay}"
                                  Content="{Binding ShowWarningsLabel}"
                                  VerticalAlignment="Center" Margin="0,2,10,2"
                                  ToolTip="Warnings render fine today but can break under realistic conditions — assets supplied by another installed mod that must stay activated, defects the ghost effect currently hides, weight-pair files this NPC's weight happens not to need."/>
                        <CheckBox IsChecked="{Binding ShowNotes, Mode=TwoWay}"
                                  Content="{Binding ShowNotesLabel}"
                                  VerticalAlignment="Center" Margin="0,2,10,2"
                                  ToolTip="Notes are engine-inert or imperceptible findings — secondary texture maps (specular, environment, subsurface) that even vanilla meshes reference without shipping, or records this mod can never forward into a patch."/>
                        <CheckBox IsChecked="{Binding ShowIgnored, Mode=TwoWay}"
                                  Content="{Binding ShowIgnoredLabel}"
                                  VerticalAlignment="Center" Margin="0,2,15,2"
                                  ToolTip="Show issues you have ignored (right-click a results row to ignore/unignore). Ignored issues are excluded from counts, badges and CSV export while hidden."/>
                        <CheckBox IsChecked="{Binding GroupByFile, Mode=TwoWay}"
                                  Content="Group by file"
                                  VerticalAlignment="Center" Margin="0,2,15,2"
                                  ToolTip="Collapse the results table to one row per distinct problem with an NPC count — shared body/head meshes repeat the same missing file across many NPCs. Clicking a mugshot still shows that NPC's individual rows."/>
                    </WrapPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding StatusSummaryText}" Margin="5,0,5,5"
                           FontStyle="Italic" TextWrapping="Wrap"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredModEntries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         x:Name="ModIssueEntriesListBox"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VM_ModIssueEntry}">
                            <Border BorderBrush="OrangeRed" BorderThickness="1" CornerRadius="3"
                                    Margin="0,2" Padding="6,4"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rescan this mod (ignore cache)"
                                                  Command="{Binding PlacementTarget.Tag.RescanModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Mods tab"
                                                Command="{Binding OpenInModsTabCommand}"
                                                Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                ToolTip="Show this mod in the Mods tab"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Margin="0,2,0,0"/>
                                    <!-- Per-type count chips double as filter toggles: clicking one
                                         drives the SAME SelectedIssueTypeFilter the Issue Type
                                         ComboBox binds (click the active chip again to clear), and
                                         the chip of the active type lights up on every entry. -->
                                    <ItemsControl ItemsSource="{Binding CountsByTypeDisplay}" Margin="0,2,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ToggleIssueTypeFilterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding Type}"
                                                        Cursor="Hand" Margin="0,1,4,1"
                                                        ToolTip="Show only this issue type (click again to show all)">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Pill" Background="{DynamicResource MugshotCaptionBackground}"
                                                                    BorderBrush="Transparent" BorderThickness="1"
                                                                    CornerRadius="7" Padding="6,1">
                                                                <TextBlock x:Name="PillText" Text="{Binding Label}" FontSize="10"
                                                                           Foreground="{DynamicResource MugshotCaptionForeground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Pill" Property="BorderBrush"
                                                                            Value="{DynamicResource MugshotCaptionForeground}"/>
                                                                </Trigger>
                                                                <!-- Active-filter highlight: this chip's type equals the
                                                                     VM's current filter selection. -->
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource AreEqualConverter}">
                                                                            <Binding Path="Type"/>
                                                                            <Binding Path="DataContext.SelectedIssueTypeFilter.Value"
                                                                                     RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter TargetName="Pill" Property="Background" Value="DodgerBlue"/>
                                                                    <Setter TargetName="PillText" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding ScanTimeText}" FontSize="10" Foreground="Gray"/>
                                        <TextBlock Text="  ⚠ Mod has changed since this scan — results may be outdated"
                                                   FontSize="10" Foreground="Orange"
                                                   Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Eligible mods with no scan result yet: absence must not read
                     as "no issues". -->
                <Expander Grid.Row="3" Margin="0,4,0,0" IsExpanded="False">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UnscannedModNames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="{Binding UnscannedModNames.Count, StringFormat='Not yet scanned ({0})'}"
                                   FontStyle="Italic" Foreground="Gray"/>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UnscannedModNames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Scan" Padding="6,0" Margin="5,0,0,0"
                                                Command="{Binding DataContext.ScanSingleModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" x:Name="ColumnSplitter"/>

            <!-- Right panel: mugshots of affected NPCs + issue table -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" MinHeight="30">
                    <Grid>
                        <TextBlock Text="{Binding SelectedEntry.DisplayName, StringFormat='NPCs with issues in: {0}', TargetNullValue='Select a mod from the left panel'}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Cancel Mugshot Load"
                                Command="{Binding CancelMugshotLoadCommand}"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Padding="5,2"
                                Visibility="{Binding IsLoadingMugshots, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="MugshotScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              SizeChanged="MugshotScrollViewer_SizeChanged"
                              PreviewMouseWheel="MugshotScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="MugshotsItemsControl" ItemsSource="{Binding CurrentModNpcMugshots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VM_ModsMenuMugshot}">
                                <Border BorderThickness="2" BorderBrush="{Binding BorderColor}" Margin="5" CornerRadius="2"
                                        Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                        PreviewMouseRightButtonDown="MugshotItem_PreviewMouseRightButtonDown"
                                        MouseLeftButtonUp="MugshotItem_MouseLeftButtonUp"
                                        ToolTip="{Binding ToolTipText}">
                                    <Grid Background="Black">
                                        <Image Source="{Binding MugshotSource}" Stretch="UniformToFill"
                                               UseLayoutRounding="True" SnapsToDevicePixels="True">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMugshot}" Value="False">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Orbiting-dragon spinner while the tile's mugshot generates,
                                             same as the NPCs/Mods menus. -->
                                        <Image x:Name="LoadingDragonImage"
                                               Source="/NPC Plugin Chooser 2;component/Resources/RedDragon.png"
                                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5"
                                               Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='50'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TransformGroup>
                                                                <TranslateTransform Y="0" /> <RotateTransform Angle="0" />
                                                            </TransformGroup>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Setter Property="local:DynamicRadiusBehavior.ImageWidth" Value="{Binding ImageWidth}" />
                                                    <Setter Property="local:DynamicRadiusBehavior.ImageHeight" Value="{Binding ImageHeight}" />
                                                    <Setter Property="local:DynamicRadiusBehavior.RadiusMultiplier" Value="0.25" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="OrbitDragon_BeginStoryboard">
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="RenderTransform.Children[1].Angle"
                                                                            From="0" To="360" Duration="0:0:3"
                                                                            RepeatBehavior="Forever" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="OrbitDragon_BeginStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="3,1"
                                                Background="{DynamicResource MugshotCaptionBackground}">
                                            <StackPanel>
                                                <!-- Multi-plugin mods: which of the mod's plugins the
                                                     record verdict(s) came from; hidden when empty. -->
                                                <TextBlock Text="{Binding ScanRecordPluginText}"
                                                           ToolTip="{Binding ScanRecordPluginText}"
                                                           Foreground="{DynamicResource MugshotCaptionForeground}"
                                                           FontSize="9" FontStyle="Italic"
                                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ScanRecordPluginText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding NpcDisplayName}" Foreground="{DynamicResource MugshotCaptionForeground}"
                                                           FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Missing Asset Indicator (Top-Center): on this tab the tooltip
                                             carries the scan's per-NPC issue list. -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                                              Visibility="{Binding HasMissingAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              ToolTip="{Binding MissingAssetNotificationText}"
                                              Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                              Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">
                                            <Viewbox Stretch="Uniform">
                                                <Image Source="/NPC Plugin Chooser 2;component/Resources/Missing Asset.png"/>
                                            </Viewbox>
                                        </Grid>

                                        <!-- Missing-outfit-assets indicator (Top-Right), from mugshot metadata. -->
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Visibility="{Binding HasMissingOutfitAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              ToolTip="{Binding MissingOutfitAssetsText}"
                                              Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                              Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">
                                            <Viewbox Stretch="Uniform">
                                                <Image Source="/NPC Plugin Chooser 2;component/Resources/Missing Outfit Assets.png"/>
                                            </Viewbox>
                                        </Grid>

                                        <!-- Data-folder-assets indicator (Top-Left), from mugshot
                                             metadata: non-vanilla assets pulled from the data folder
                                             (keep-activated runtime dependency). Informational. -->
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Visibility="{Binding HasDataFolderAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              ToolTip="{Binding DataFolderAssetsText}"
                                              Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                              Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">
                                            <Viewbox Stretch="Uniform">
                                                <Image Source="/NPC Plugin Chooser 2;component/Resources/Data Folder Assets.png" />
                                            </Viewbox>
                                        </Grid>
                                    </Grid>

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Jump to NPC in List" Command="{Binding JumpToNpcCommand}"/>
                                            <MenuItem Header="View Full Screen (Ctrl+RClick)" Command="{Binding ToggleFullScreenCommand}"/>
                                            <MenuItem Header="Show 3D Preview (Ctrl+Shift+RClick)" Command="{Binding Show3DPreviewCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{DynamicResource BorderBrush}" ResizeDirection="Rows"/>

                <!-- Issue table: every problem for the selected mod; clicking a
                     mugshot narrows it to that NPC. -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding IssueTableHeaderText}" FontStyle="Italic"
                               Margin="2,4,2,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding OutfitHintText}" Foreground="Orange"
                               Margin="2,0,2,2" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutfitHintText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Theme resources carry no implicit DataGrid styles, so the
                         grid is themed inline — same recipe as ValidationResultsWindow. -->
                    <!-- ScrollUnit=Pixel (here and on every results table): the default
                         item-based scrolling advances by whole rows, which jumps with tall
                         rows and — worse — cannot reach the bottom of a row taller than
                         what remains of the viewport (a fully-scrolled Details cell kept
                         its last line clipped). Pixel scrolling fixes both and keeps row
                         virtualization. -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding IssueTableRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True"
                              HeadersVisibility="Column" SelectionMode="Extended"
                              SelectionUnit="CellOrRowHeader" RowHeaderWidth="0"
                              ClipboardCopyMode="ExcludeHeader"
                              GridLinesVisibility="All"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Background="{DynamicResource SecondaryBackground}"
                              Foreground="{DynamicResource PrimaryForeground}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              RowBackground="{DynamicResource SecondaryBackground}"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy selected cells"
                                          Command="ApplicationCommands.Copy"
                                          InputGestureText="Ctrl+C"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="6,4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedItemBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                <!-- The VM rides in on Tag so the row's context menu
                                     (outside the visual tree) can reach its commands;
                                     the row item itself is the CommandParameter. -->
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Ignore this file for this mod (all NPCs)"
                                                      Command="{Binding PlacementTarget.Tag.IgnoreFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Ignore this file in ALL mods"
                                                      Command="{Binding PlacementTarget.Tag.IgnoreFileAllModsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Ignore exactly this row's issue(s)"
                                                      Command="{Binding PlacementTarget.Tag.IgnoreExactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Unignore"
                                                      Command="{Binding PlacementTarget.Tag.UnignoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="Copy NPC">
                                                <MenuItem Header="Name"
                                                          Command="{Binding PlacementTarget.Tag.CopyNpcNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="EditorID"
                                                          Command="{Binding PlacementTarget.Tag.CopyNpcEditorIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="FormID (load order)"
                                                          Command="{Binding PlacementTarget.Tag.CopyNpcFormIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="FormKey"
                                                          Command="{Binding PlacementTarget.Tag.CopyNpcFormKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </MenuItem>
                                            <MenuItem Header="Copy selected cells"
                                                      Command="ApplicationCommands.Copy"
                                                      InputGestureText="Ctrl+C"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarningForeground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNote}" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style x:Key="WrappingCellText" TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NPC" Binding="{Binding NpcDisplayName}" Width="Auto"/>
                            <DataGridTextColumn Header="NPCs" Binding="{Binding NpcCount}" Width="Auto"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                            <DataGridTextColumn Header="Issue" Binding="{Binding TypeDisplay}" Width="Auto"/>
                            <!-- Which of the scanned mod's plugins the record verdict came
                                 from (multi-plugin mods only; empty elsewhere). -->
                            <DataGridTextColumn Header="Plugin" Binding="{Binding Plugin}" Width="Auto"
                                                ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Missing / Affected Path" Binding="{Binding AffectedPath}" Width="2*"
                                                ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="*"
                                                ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Referenced By" Binding="{Binding Referencer}" Width="*"
                                                ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Provided By" Binding="{Binding ProvidedBy}" Width="*"
                                                ElementStyle="{StaticResource WrappingCellText}"/>
                            <!-- Details can run to dozens of lines (dark-face reason texts); the
                                 row simply grows to fit. Tall rows are fine under ScrollUnit=Pixel,
                                 which is what retired the old height-capped cell ScrollViewer — its
                                 two-level wheel handoff (cell scroll, then table scroll) read badly,
                                 and the cap only ever existed because item-based scrolling could not
                                 navigate tall rows. ClipboardContentBinding keeps Ctrl+C intact. -->
                            <DataGridTemplateColumn Header="Details" Width="2*"
                                                    ClipboardContentBinding="{Binding DetailWithRemedy}"
                                                    SortMemberPath="Detail">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- IssueDetailFormatter splices the green repin-remedy
                                             line directly under the verdict's headline. -->
                                        <TextBlock local:IssueDetailFormatter.DetailText="{Binding Detail}"
                                                   local:IssueDetailFormatter.RemedyText="{Binding RepinRemedy}"
                                                   TextWrapping="Wrap" Padding="0,0,4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ====================== Zoom bar ====================== -->
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Button x:Name="ZoomOutButton" Content="-" Width="25" Margin="0,0,2,0"/>
                <TextBox x:Name="ZoomPercentageTextBox" Width="50" VerticalAlignment="Center" TextAlignment="Center"
                         PreviewMouseWheel="ZoomPercentageTextBox_PreviewMouseWheel"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,2,0"/>
                <Button x:Name="ZoomInButton" Content="+" Width="25" Margin="0,0,10,0"/>
                <CheckBox x:Name="LockZoomCheckBox" Content="Lock" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="Keep the current zoom level instead of auto-fitting"/>
                <Button x:Name="ResetZoomButton" Content="Reset" Padding="8,1"
                        ToolTip="Return to automatic fit"/>
            </StackPanel>
        </Border>
    </Grid>
</reactiveui:ReactiveUserControl>
