<reactiveui:ReactiveWindow x:Class="NPC_Plugin_Chooser_2.Views.OverrideRootSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NPC_Plugin_Chooser_2.Views"
        xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
        xmlns:themes="clr-namespace:NPC_Plugin_Chooser_2.Themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:reactiveui="http://reactiveui.net"
        mc:Ignorable="d"
        x:TypeArguments="vm:VM_OverrideRootSelector"
        Style="{DynamicResource ThemedWindowStyle}"
        Title="Override Roots" Height="620" Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <i:Interaction.Behaviors>
        <themes:TitleBarThemingBehavior />
    </i:Interaction.Behaviors>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Which fields of an NPC record the search for this mod's overridden records may START from."/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0">
                A ticked field is followed as deep as it goes, through any kind of record — this does not
                limit which record types can be pulled in, only where the search begins. The defaults are the
                fields that carry appearance. Adding others (AI packages especially) lets the search wander
                into unrelated records and copy them into the output, so tick them only if this mod needs it.
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VM_SelectableRootField}">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      ToolTip="{Binding ToolTip}"
                                      Margin="8,3"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- The appearance set reads as the "normal" choice; everything
                                                     else is dimmed so an opted-in extra stands out. -->
                                                <DataTrigger Binding="{Binding IsAppearanceDefault}" Value="False">
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}" Margin="2,8,0,0" Opacity="0.9" TextWrapping="Wrap"/>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Reset to Defaults" Padding="8,2" Command="{Binding ResetToDefaultsCommand}"/>
                <Button Content="Check All" Padding="8,2" Margin="5,0,0,0" Command="{Binding CheckAllCommand}"/>
                <Button Content="Uncheck All" Padding="8,2" Margin="5,0,0,0" Command="{Binding UncheckAllCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" IsDefault="True" Command="{Binding OKCommand}"/>
                <Button Content="Cancel" Width="80" Margin="5,0,0,0" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</reactiveui:ReactiveWindow>
