<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Home-built Nifly (NiflySharp) pinned to upstream commit 7126e3f until ousnius
         publishes a release past 1.1.0. -->
    <add key="npc2-local" value="LocalPackages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="npc2-local">
      <package pattern="Nifly" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
