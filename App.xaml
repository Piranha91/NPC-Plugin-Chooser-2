<Application x:Class="NPC_Plugin_Chooser_2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NPC_Plugin_Chooser_2"
             xmlns:views="clr-namespace:NPC_Plugin_Chooser_2.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <!-- Lock 3D View toggle (NPCs, Mods and Compare views). Theme-independent
                 bevel so it reads as a button on any theme and on the Compare
                 window's dark overlay. Raised = unlocked (icon dimmed); pressed-in
                 with a green rim = locked. The icon sits in a ZeroDesiredSizeDecorator
                 and the button stretches vertically, so it takes its row's existing
                 height (Width tracks ActualHeight to stay square) and never grows it. -->
            <BitmapImage x:Key="Lock3DViewIcon" DecodePixelWidth="96"
                         UriSource="pack://application:,,,/NPC Plugin Chooser 2;component/Resources/Lock 3D View.png"/>
            <Style x:Key="Lock3DViewToggleStyle" TargetType="ToggleButton">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="Lock 3D View is OFF: each live tile's camera moves independently. Click to lock all live tiles to the same view."/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Outer" CornerRadius="3" BorderThickness="1" BorderBrush="#FF3A3A3A">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFF2F2F2" Offset="0"/>
                                        <GradientStop Color="#FFC4C4C4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border x:Name="Bevel" CornerRadius="2" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                            <GradientStop Color="#60000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <views:ZeroDesiredSizeDecorator x:Name="IconHost" Margin="1">
                                        <Image x:Name="Icon" Source="{StaticResource Lock3DViewIcon}" Stretch="Uniform"
                                               Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </views:ZeroDesiredSizeDecorator>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Outer" Property="BorderBrush" Value="#FF7A7A7A"/>
                                    <Setter TargetName="Icon" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <!-- Pressed-in look for both the mouse-down moment and the locked state. -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="False"/>
                                        <Condition Property="IsPressed" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="IconHost" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
                                    </Setter>
                                </MultiTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Outer" Property="BorderBrush" Value="#FF2E9E4F"/>
                                    <Setter TargetName="Outer" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFA9A9A9" Offset="0"/>
                                                <GradientStop Color="#FFDADADA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Bevel" Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#70000000" Offset="0"/>
                                                <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="IconHost" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="ToolTip" Value="Lock 3D View is ON: rotating, moving or zooming any live tile moves all of them together. Click to unlock."/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
